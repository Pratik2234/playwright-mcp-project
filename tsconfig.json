    "target": "ES2022",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "outDir": "dist",

    "rootDir": ".",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true
  },

  "include": [
    "mcp-server/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts"
  ]
}